---
// src/pages/index.astro
// Snow Rider 3D Unblocked — Astro conversion of the original static HTML page.
// All markup, styling, and behaviour preserved 1:1; only the wrapper is now
// an Astro component instead of a raw .html file.

const title = "Snow Rider 3D Unblocked";
const description =
  "Play Snow Rider 3D Unblocked for free! Experience the thrill of 3D sledding, dodge obstacles, and challenge high scores in this unlocked winter adventure.";
const keywords =
  "snow rider 3d unblocked, snow rider 3d, unblocked games, sled game, winter games 3d";
const canonicalUrl = "https://snowrider3dubg.bitbucket.io/";
const ogImage = "https://snowrider3dubg.bitbucket.io/snowrider3d.png";
const gaId = "G-3B5BQGW112";

const reviews = [
  {
    author: "Rachelle Amundson",
    rating: 4,
    text: "Pretty fun, though some levels are meant to just use your power ups. Level 200 doesn't actually allow you to win, there's supposedly another ghost, even with no balls left. Also wish the explanation to get rid of certain balls was more in depth.",
  },
  {
    author: "Ms Ragnvindr",
    rating: 3,
    text: "A cute, fun game but since just before level 130, it's been plain annoying. I like a challenge... Eventually you give in and use the power ups, or the game gives more pauses and reverses, but that's after many, MANY fails.",
  },
  {
    author: "Kaysie Anderson",
    rating: 2,
    text: "Finally deleting at level 268... The levels are designed so that you often need to watch an ad in the middle of the game to beat it, & you have to watch 1 between every level/loss.",
  },
  {
    author: "Johnathon Cansibog",
    rating: 2,
    text: "Has serious glitches. If you use specials or watch videos to back. The game will continue to go but will not send out anything. So you will be able to fire at the bonus but the game will not send the ghost.",
  },
  {
    author: "Lindiwe Alice",
    rating: 1,
    text: "It was fun in the beginning until I got stuck on stage 56, it isn't moving at all. Whoever created this game wanted to see some people dead. The balls are so fast 😫 it's literally impossible to move to the next stage.",
  },
];

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  applicationCategory: "Game",
  operatingSystem: "Web Browser",
  url: canonicalUrl,
  image: ogImage,
  description:
    "A thrilling 3D sledding game where players dodge obstacles and collect gifts.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.2",
    reviewCount: "5",
  },
  review: reviews.map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.author },
    reviewBody: r.text,
    reviewRating: { "@type": "Rating", ratingValue: String(r.rating) },
  })),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="7PvrAHsnFPaeq7OUeh1rRrcE8tks8UshxaaNRgcP158" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content="Ride the sleigh and dodge obstacles in Snow Rider 3D Unblocked. Play now for free!" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

    <style>
        :root {
            --primary: #0ea5e9;
            --bg: #f0f9ff;
            --text: #0f172a;
            --border: #bae6fd;
            --card-bg: #ffffff;
            --overlay-bg: #f0f9ff;
            --accent: #0284c7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        header {
            display: flex;
            justify-content: center;
            margin-bottom: 30px;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 20px;
        }

        .logo {
            font-weight: 900;
            color: var(--primary);
            font-size: 1.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-shadow: 2px 2px 0px rgba(14, 165, 233, 0.1);
        }

        .game-wrapper {
            background: #000;
            border-radius: 12px;
            aspect-ratio: 16 / 9;
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            border: 6px solid var(--primary);
            position: relative;
            box-shadow: 0px 10px 25px rgba(14, 165, 233, 0.25);
            overflow: hidden;
        }

        .game-wrapper:fullscreen {
            border: none;
            border-radius: 0;
            width: 100vw;
            height: 100vh;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .overlay {
            position: absolute;
            inset: 0;
            background: var(--overlay-bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .btn-play {
            background: var(--primary);
            color: white;
            border: none;
            padding: 16px 50px;
            font-weight: 800;
            font-size: 1.2rem;
            cursor: pointer;
            text-transform: uppercase;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.4);
            transition: transform 0.2s, background 0.2s;
        }

        .btn-play:hover {
            transform: scale(1.05);
            background: var(--accent);
        }

        .btn-fullscreen {
            position: absolute;
            bottom: 12px;
            right: 12px;
            background: rgba(0, 0, 0, 0.5);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            backdrop-filter: blur(4px);
        }

        .btn-fullscreen:hover {
            background: var(--primary);
            border-color: white;
            transform: scale(1.1);
        }

        .btn-fullscreen svg {
            fill: currentColor;
            width: 20px;
            height: 20px;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 25px auto;
            max-width: 800px;
            gap: 10px;
            background: var(--card-bg);
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .game-info-tag {
            font-weight: bold;
            font-size: 13px;
            text-transform: uppercase;
            color: var(--accent);
        }

        .server-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .server-alert {
            font-size: 11px;
            font-weight: bold;
            color: #ef4444;
            text-transform: uppercase;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .server-select {
            padding: 8px 12px;
            border: 2px solid var(--border);
            border-radius: 4px;
            background: white;
            font-weight: bold;
            color: var(--text);
            cursor: pointer;
            outline: none;
        }

        .reviews-section {
            margin-top: 50px;
            border-top: 2px solid var(--border);
            padding-top: 30px;
        }

        .section-title {
            text-align: center;
            color: var(--text);
            margin-bottom: 30px;
            font-size: 1.5rem;
            font-weight: 800;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .review-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: 0.2s;
        }

        .review-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(14, 165, 233, 0.15);
        }

        .review-author {
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .review-author::before {
            content: '👤';
            font-size: 1.2em;
        }

        .review-text {
            font-size: 0.95rem;
            color: #475569;
            font-style: italic;
        }

        .seo-content {
            max-width: 800px;
            margin: 20px auto;
            font-size: 0.9rem;
            color: #64748b;
            text-align: center;
        }

        .hidden {
            display: none !important;
        }

        footer {
            margin-top: 60px;
            text-align: center;
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            body {
                padding: 10px;
                overflow-x: hidden;
            }
            .logo {
                font-size: 1.4rem;
                margin-top: 5px;
            }
            .game-wrapper {
                border-width: 3px;
                width: 100%;
            }
            .controls {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
                text-align: center;
                width: 100%;
            }
            .server-box {
                flex-direction: column;
                align-items: stretch;
                width: 100%;
                gap: 5px;
            }
            .server-select {
                flex-grow: 1;
                width: 100%;
                text-align: center;
            }
            .btn-play {
                padding: 12px 30px;
                font-size: 1rem;
                width: 80%;
                max-width: 250px;
            }
            .reviews-grid {
                grid-template-columns: 1fr;
            }
            .server-alert {
                display: none;
            }
        }

        /* Buy-site widget */
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&display=swap');

        .buy-site-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 99999;
        }

        .cute-buy-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 50%, #6366f1 100%);
            color: #ffffff !important;
            text-decoration: none !important;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 15px;
            padding: 12px 22px;
            border-radius: 999px;
            box-shadow: 0 10px 25px rgba(236, 72, 153, 0.35), 0 0 0 3px rgba(255, 255, 255, 0.85);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
            cursor: pointer;
            border: none;
            letter-spacing: 0.3px;
            animation: gentle-pulse 2.5s infinite;
        }

        .cute-buy-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -60%;
            width: 40px;
            height: 200%;
            background: linear-gradient(
                to right,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.4) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            transform: rotate(25deg);
            animation: btn-shine 3.5s infinite;
        }

        .cute-buy-btn:hover {
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 15px 30px rgba(139, 92, 246, 0.45), 0 0 0 4px #ffffff;
        }

        .cute-buy-btn:active {
            transform: scale(0.96);
        }

        .cute-buy-icon {
            font-size: 18px;
            display: inline-block;
            animation: wiggle 2s infinite ease-in-out;
        }

        .cute-price-tag {
            background: rgba(255, 255, 255, 0.25);
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.35);
        }

        @keyframes btn-shine {
            0% { left: -60%; }
            20%, 100% { left: 140%; }
        }

        @keyframes gentle-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }

        @keyframes wiggle {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-10deg); }
            75% { transform: rotate(10deg); }
        }

        @media (max-width: 600px) {
            .buy-site-container {
                bottom: 16px;
                right: 16px;
            }
            .cute-buy-btn {
                font-size: 13px;
                padding: 10px 18px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1 class="logo">SNOW RIDER 3D</h1>
    </header>

    <main>
        <div class="game-wrapper" id="gameWrapper">
            <iframe id="gameFrame" src="about:blank" title="Snow Rider 3D Unblocked Game Frame" allowfullscreen></iframe>

            <div id="overlay" class="overlay">
                <div id="status" style="margin-bottom: 20px; font-weight: bold; color: var(--accent);">LOADING SNOW TRACKS...</div>
                <div id="playAction" class="hidden">
                    <button class="btn-play" id="playBtn">PLAY NOW</button>
                </div>
            </div>

            <button class="btn-fullscreen" id="fullscreenBtn" title="Toggle Fullscreen">
                <svg viewBox="0 0 24 24">
                    <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"></path>
                </svg>
            </button>
        </div>

        <div class="controls">
            <div class="game-info-tag">SLED_ID: <span id="activeGameTitle">...</span></div>
            <div class="server-box">
                <span class="server-alert">Game frozen? Switch Server &rarr;</span>
                <select id="serverSelect" class="server-select" aria-label="Select Game Server"></select>
            </div>
        </div>

        <article class="seo-content">
            <p>Welcome to <strong>Snow Rider 3D Unblocked</strong>. Experience the ultimate winter sports challenge directly in your browser. Navigate your sled through treacherous snowy mountains, avoid massive obstacles, and collect gifts to unlock exciting new sleighs. Perfect for school or work breaks!</p>
        </article>

        <section class="reviews-section">
            <h2 class="section-title">WHAT OUR USERS SAY</h2>
            <div class="reviews-grid">
                {reviews.map((r) => (
                    <div class="review-card">
                        <div class="review-author">{r.author}</div>
                        <p class="review-text">"{r.text}"</p>
                    </div>
                ))}
            </div>
        </section>
    </main>

    <footer>
        &copy; 2026 Snow Rider 3D Unblocked • Winter Gaming Portal
    </footer>
</div>

<div class="buy-site-container">
    <a href="https://snowrider3dubg.bitbucket.io/buy.html" class="cute-buy-btn" id="buySiteBtn" target="_blank" rel="noopener noreferrer">
        <span class="cute-buy-icon">🏷️</span>
        <span>Buy This Site</span>
        <span class="cute-price-tag">$1000</span>
    </a>
</div>

<script>
    const JSON_URL = "https://sidgames.pages.dev/games.json";
    const KEY = "snowrider3d";
    let gameUrls: string[] = [];
    let currentUrl = "";

    async function init() {
        try {
            const res = await fetch(`${JSON_URL}?t=${Date.now()}`);
            const data = await res.json();
            gameUrls = data[KEY] || [];

            if (gameUrls.length > 0) {
                document.getElementById('activeGameTitle')!.textContent = "SNOW_RIDER_V1";
                renderServerList();
                showPlayButton();
            }
        } catch (e) {
            document.getElementById('status')!.textContent = "BLIZZARD BLOCKED CONNECTION";
        }
    }

    function renderServerList() {
        const select = document.getElementById('serverSelect') as HTMLSelectElement;
        select.innerHTML = gameUrls
            .map((url, i) => `<option value="${url}">ICE SERVER 0${i + 1}</option>`)
            .join('');
        currentUrl = gameUrls[0];
        select.addEventListener('change', () => changeServer(select.value));
    }

    function showPlayButton() {
        document.getElementById('status')!.classList.add('hidden');
        document.getElementById('playAction')!.classList.remove('hidden');
    }

    function changeServer(val: string) {
        currentUrl = val;
        if (document.getElementById('overlay')!.classList.contains('hidden')) {
            startGame();
        }
    }

    function startGame() {
        const frame = document.getElementById('gameFrame') as HTMLIFrameElement;
        const overlay = document.getElementById('overlay')!;

        frame.src = currentUrl;
        overlay.innerHTML = `<div style="color:var(--primary); font-weight: bold; font-size: 1.2rem;">LAUNCHING SLED...</div>`;

        frame.onload = () => {
            overlay.classList.add('hidden');
        };
    }

    function toggleFullscreen() {
        const wrapper = document.getElementById('gameWrapper')!;

        if (!document.fullscreenElement) {
            if (wrapper.requestFullscreen) {
                wrapper.requestFullscreen();
            } else if ((wrapper as any).webkitRequestFullscreen) {
                (wrapper as any).webkitRequestFullscreen();
            } else if ((wrapper as any).msRequestFullscreen) {
                (wrapper as any).msRequestFullscreen();
            }
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            } else if ((document as any).webkitExitFullscreen) {
                (document as any).webkitExitFullscreen();
            } else if ((document as any).msExitFullscreen) {
                (document as any).msExitFullscreen();
            }
        }
    }

    document.getElementById('playBtn')?.addEventListener('click', startGame);
    document.getElementById('fullscreenBtn')?.addEventListener('click', toggleFullscreen);

    window.addEventListener('load', init);
</script>

<script>
    (function () {
        const btn = document.getElementById('buySiteBtn');
        if (btn) {
            btn.addEventListener('click', function (e: MouseEvent) {
                const ripple = document.createElement('span');
                ripple.style.position = 'absolute';
                ripple.style.borderRadius = '50%';
                ripple.style.background = 'rgba(255, 255, 255, 0.6)';
                ripple.style.transform = 'scale(0)';
                ripple.style.animation = 'ripple-effect 0.6s linear';
                ripple.style.pointerEvents = 'none';

                const rect = btn.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';

                btn.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });
        }
    })();
</script>

</body>
</html>
