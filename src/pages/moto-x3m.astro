---
// src/pages/moto-x3m.astro
const featuredGame = {
  title: "🏍️ Moto X3M Unblocked 🏁✨",
  embedUrl: "https://moto-x3m.github.io/", // Moto X3M embed
  description: "Moto X3M Unblocked ek high-speed stunt bike racing game hai! Insane obstacles ko cross karein, backflips lagayein aur har level 3-stars ke sath complete karein bina kisi restrictions ke! 🚀🔥",
  tags: ["#MotoX3M", "#UnblockedGames", "#BikeRacing", "#Stunts", "#CuteArcade"]
};

const moreGames = [
  {
    title: "Drift Boss Unblocked 🚗",
    category: "Drifting",
    emoji: "🏎️💨",
    rating: "⭐ 4.9",
    tag: "Hot 🔥",
    url: "/snow/drift-boss/"
  },
  {
    title: "PolyTrack 3D 🏎️",
    category: "Racing",
    emoji: "🏎️🏁",
    rating: "⭐ 4.9",
    tag: "Popular 🎉",
    url: "/snow/"
  },
  {
    title: "Cat Bakery Tycoon 🐾",
    category: "Simulation",
    emoji: "🐱🥐",
    rating: "⭐ 4.9",
    tag: "Cute 💖",
    url: "/snow/"
  },
  {
    title: "Cozy Pixel Farm 🌾",
    category: "Casual",
    emoji: "🐥🥕",
    rating: "⭐ 4.8",
    tag: "Relaxing 🌸",
    url: "/snow/"
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- 🎯 SEO Target: Moto X3M Unblocked -->
    <title>Moto X3M Unblocked 🏍️ Play Free Online Stunt Bike Game | OrangeArcade</title>
    <meta name="description" content="Play Moto X3M Unblocked for free online in full screen! Perform cool bike flips, dodge deadly obstacles, and beat track records at school or work." />
    <meta name="keywords" content="moto x3m unblocked, moto x3m unblocked 76, moto x3m unblocked games 66, play moto x3m online, stunt bike game" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏍️</text></svg>" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Quicksand:wght@600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- 🍊 Navbar -->
    <header class="navbar">
      <a href="/snow/" class="logo">
        <span class="logo-icon">🍊</span>
        <span class="logo-text">Orange<span class="highlight">Arcade</span></span>
      </a>
      <nav class="nav-links">
        <a href="/snow/" class="nav-btn">🏠 Home</a>
        <a href="/snow/drift-boss/" class="nav-btn">🚗 Drift Boss</a>
        <a href="#how-to-play" class="nav-btn cute-btn">📖 Controls</a>
      </nav>
    </header>

    <main class="container">
      <!-- 🎮 Moto X3M Game Section -->
      <section class="game-showcase">
        <div class="section-badge">🔥 Popular Stunt Game 🏍️</div>
        <h1 class="game-title">{featuredGame.title}</h1>

        <!-- 🕹️ Click to Play Facade Frame -->
        <div class="iframe-wrapper" id="motoBox">
          <div class="play-overlay" id="playOverlay">
            <div class="poster-badge">🏆 25+ Extreme Levels</div>
            <div class="poster-icon">🏍️💥</div>
            <p class="poster-hint">Click below to start extreme bike stunts!</p>
            <button class="big-play-btn" id="playBtn" onclick="loadMotoGame()">
              ▶ PLAY MOTO X3M
            </button>
          </div>
        </div>

        <div class="game-info">
          <p class="desc">{featuredGame.description}</p>
          <div class="tags">
            {featuredGame.tags.map(tag => <span class="tag-pill">{tag}</span>)}
          </div>
        </div>
      </section>

      <!-- 📖 SEO Content & Guide Section -->
      <section id="how-to-play" class="seo-guide-section">
        <div class="guide-card">
          <h2>🎯 What is Moto X3M Unblocked?</h2>
          <p>
            <strong>Moto X3M Unblocked</strong> ek super exciting 2D motocross stunt racing game hai. Isme aapko deadly spikes, giant loops, aur falling platforms se bachkar finish line tak sabse kam time me pahunchna hota hai.
          </p>

          <div class="controls-grid">
            <div class="control-box">
              <span class="ctrl-icon">⬆️ / W</span>
              <h3>Accelerate (Speed)</h3>
              <p>Gas press karke bike ki speed badhayein.</p>
            </div>
            <div class="control-box">
              <span class="ctrl-icon">⬇️ / S</span>
              <h3>Brake / Reverse</h3>
              <p>Obstacles se pehle speed slow karein.</p>
            </div>
            <div class="control-box">
              <span class="ctrl-icon">⬅️ ➡️ / A D</span>
              <h3>Tilt & Flips</h3>
              <p>Air me frontflip aur backflip karke time bachayein.</p>
            </div>
          </div>

          <h3>✨ Pro Tips to Get 3 Stars in Moto X3M:</h3>
          <ul class="tips-list">
            <li>🔄 <strong>Air Flips reduce time:</strong> Har front flip ya back flip karne par aapke timer se 0.5 seconds kam ho jate hain!</li>
            <li>🏍️ <strong>Land on Wheels:</strong> Hamesha dono wheels par land karein taaki bike crash na ho.</li>
            <li>⚡ <strong>Use Boosters:</strong> Green speed-pads aur TNT explosions ko smartly use karke high jumps karein.</li>
          </ul>
        </div>
      </section>

      <!-- 🕹️ More Games Grid -->
      <section class="more-games-section">
        <div class="section-header">
          <h2>🐾 More Unblocked Games 🍊</h2>
          <p>Explore other popular games in our cute arcade!</p>
        </div>

        <div class="games-grid">
          {moreGames.map(game => (
            <article class="game-card">
              <span class="card-badge">{game.tag}</span>
              <div class="card-icon">{game.emoji}</div>
              <h3 class="card-title">{game.title}</h3>
              <p class="card-cat">{game.category}</p>
              <div class="card-bottom">
                <span class="rating">{game.rating}</span>
                <a href={game.url} class="play-btn">Play 🕹️</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <!-- 🌸 Footer -->
    <footer>
      <p>Made with 🧡 & Astro JS | Moto X3M Unblocked • OrangeArcade ✨🐾</p>
    </footer>

    <!-- 🚀 Instant Load Script -->
    <script is:inline>
      function loadMotoGame() {
        var box = document.getElementById('motoBox');
        box.innerHTML = '<iframe src="https://moto-x3m.github.io/" title="Moto X3M Unblocked" allow="autoplay; fullscreen; pointer-lock" allowfullscreen class="active-iframe"></iframe>';
      }
    </script>
  </body>
</html>

<style>
  :root {
    --primary-orange: #d95300;
    --soft-orange: #ff7b25;
    --light-peach: #fff7f2;
    --card-bg: #ffffff;
    --text-dark: #3a2210;
    --border-orange: #ffd8bf;
    --shadow-cute: 0px 10px 24px rgba(217, 83, 0, 0.12);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Quicksand', system-ui, sans-serif; background-color: var(--light-peach); color: var(--text-dark); line-height: 1.5; }
  
  /* 🍊 Navbar */
  .navbar { display: flex; justify-content: space-between; align-items: center; padding: 1rem clamp(1rem, 4vw, 2.5rem); max-width: 1000px; margin: 0 auto; }
  .logo { display: flex; align-items: center; gap: 0.4rem; font-family: 'Fredoka', system-ui, sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--primary-orange); text-decoration: none; }
  .highlight { color: var(--soft-orange); }
  .nav-links { display: flex; gap: 0.6rem; }
  .nav-btn { text-decoration: none; font-weight: 700; color: var(--text-dark); padding: 0.5rem 1rem; border-radius: 99px; font-size: 0.9rem; }
  .cute-btn { background: var(--primary-orange); color: #fff; }

  /* 📦 Layout */
  .container { width: 100%; max-width: min(950px, 94vw); margin: 1rem auto 3rem auto; }
  .game-showcase { background: var(--card-bg); border-radius: 24px; padding: clamp(1rem, 3vw, 2rem); text-align: center; border: 2px solid var(--border-orange); box-shadow: var(--shadow-cute); }
  .section-badge { display: inline-block; background: #ffe3cd; color: var(--primary-orange); font-weight: 700; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem; margin-bottom: 0.6rem; }
  .game-title { font-family: 'Fredoka', system-ui, sans-serif; font-size: clamp(1.4rem, 4vw, 2rem); color: var(--primary-orange); margin-bottom: 1.2rem; }
  
  /* 🕹️ Fast Facade Frame */
  .iframe-wrapper { position: relative; width: 100%; max-width: 800px; margin: 0 auto; aspect-ratio: 16 / 9; min-height: 250px; border-radius: 18px; overflow: hidden; background: #1e130c; border: 4px solid var(--soft-orange); display: flex; align-items: center; justify-content: center; }
  .play-overlay { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem; padding: 1rem; }
  .poster-badge { background: rgba(255, 123, 37, 0.2); color: #ffaa66; font-weight: 700; font-size: 0.8rem; padding: 0.2rem 0.8rem; border-radius: 20px; }
  .poster-icon { font-size: 3rem; }
  .poster-hint { color: #ffd8bf; font-weight: 600; font-size: 0.95rem; }
  .big-play-btn { background: var(--primary-orange); color: #ffffff; border: 3px solid #ffe3cd; padding: 0.8rem 2rem; font-family: 'Fredoka', sans-serif; font-size: 1.2rem; font-weight: 700; border-radius: 99px; cursor: pointer; transition: transform 0.2s ease; }
  .big-play-btn:hover { transform: scale(1.05); }
  :global(.active-iframe) { width: 100%; height: 100%; border: none; }
  
  .game-info { margin-top: 1.2rem; }
  .desc { font-size: 1rem; font-weight: 600; color: #55341c; margin-bottom: 0.8rem; }
  .tags { display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; }
  .tag-pill { background: #fff0e2; color: var(--primary-orange); padding: 0.2rem 0.7rem; border-radius: 10px; font-size: 0.8rem; font-weight: 700; }
  
  /* 📖 Guide & Controls */
  .seo-guide-section { margin-top: 2.5rem; }
  .guide-card { background: var(--card-bg); border: 2px solid var(--border-orange); border-radius: 20px; padding: 1.5rem; text-align: left; box-shadow: var(--shadow-cute); }
  .guide-card h2 { font-family: 'Fredoka', sans-serif; color: var(--primary-orange); font-size: 1.4rem; margin-bottom: 0.6rem; }
  .guide-card h3 { font-family: 'Fredoka', sans-serif; color: var(--text-dark); margin: 1.2rem 0 0.6rem 0; }
  .controls-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin: 1.2rem 0; }
  .control-box { background: #fff3ea; border: 1.5px solid var(--border-orange); border-radius: 16px; padding: 1rem; text-align: center; }
  .ctrl-icon { font-size: 1.8rem; font-weight: 700; color: var(--primary-orange); display: block; margin-bottom: 0.3rem; }
  .tips-list { margin-left: 1.2rem; font-weight: 600; color: #55341c; }
  .tips-list li { margin-bottom: 0.4rem; }

  /* 🕹️ More Games Grid */
  .more-games-section { margin-top: 3rem; }
  .section-header { text-align: center; margin-bottom: 1.5rem; }
  .section-header h2 { font-family: 'Fredoka', sans-serif; font-size: 1.6rem; color: var(--primary-orange); }
  .section-header p { color: #6e4b30; font-weight: 600; }
  .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 1.2rem; }
  .game-card { background: var(--card-bg); border: 1.5px solid var(--border-orange); border-radius: 18px; padding: 1.2rem; text-align: center; position: relative; }
  .card-badge { position: absolute; top: 10px; right: 10px; background: #ffe6d4; font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; color: var(--primary-orange); }
  .card-icon { font-size: 2.6rem; margin: 0.5rem 0; }
  .card-title { font-family: 'Fredoka', sans-serif; font-size: 1.1rem; margin-bottom: 0.2rem; }
  .card-cat { font-size: 0.8rem; color: #8c6a4d; font-weight: 600; margin-bottom: 1rem; }
  .card-bottom { display: flex; justify-content: space-between; align-items: center; }
  .rating { font-weight: 700; font-size: 0.85rem; color: #d95300; }
  .play-btn { background: var(--primary-orange); color: #fff; text-decoration: none; font-weight: 700; padding: 0.45rem 0.9rem; border-radius: 10px; }

  footer { text-align: center; padding: 1.5rem; font-weight: 600; font-size: 0.9rem; color: #6e4b30; background: #ffede0; margin-top: 2.5rem; }
</style>
