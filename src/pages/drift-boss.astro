---
// src/pages/drift-boss.astro
const gameDetails = {
  title: "🚗 Drift Boss Unblocked 🏎️✨",
  embedUrl: "https://drift-boss.github.io/", // Drift Boss Unblocked Embed
  description: "Drift Boss Unblocked ek ultimate one-button 3D drifting arcade game hai. Sharp turns par drift karein, coins collect karein aur cool new cars unlock karein bina kisi block ke!",
  tags: ["#DriftBoss", "#UnblockedGames", "#Arcade", "#OneClick", "#CuteGames"]
};

// Base URL handling for GitHub Pages (/snow/)
const baseUrl = import.meta.env.BASE_URL;

const moreGames = [
  {
    title: "PolyTrack 3D 🏎️",
    category: "Racing",
    emoji: "🏎️🏁",
    rating: "⭐ 4.9",
    tag: "Popular 🔥",
    url: `${baseUrl}`
  },
  {
    title: "Cat Bakery Tycoon 🐾",
    category: "Simulation",
    emoji: "🐱🥐",
    rating: "⭐ 4.9",
    tag: "Cute 💖",
    url: `${baseUrl}`
  },
  {
    title: "Cozy Pixel Farm 🌾",
    category: "Casual",
    emoji: "🐥🥕",
    rating: "⭐ 4.8",
    tag: "Relaxing 🌸",
    url: `${baseUrl}`
  },
  {
    title: "Sunny Space Jump 🚀",
    category: "Action",
    emoji: "🌟🍊",
    rating: "⭐ 4.7",
    tag: "Fun 🎉",
    url: `${baseUrl}`
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- 🎯 SEO Target: Drift Boss Unblocked -->
    <title>Drift Boss Unblocked 🚗 Play Free Online Game | OrangeArcade</title>
    <meta name="description" content="Play Drift Boss Unblocked for free online in full screen! Master sharp corner drifts, collect coins, and unlock awesome cars at school or work." />
    <meta name="keywords" content="drift boss unblocked, drift boss game online, play drift boss unblocked, 3d drift game, unblocked games 76 66" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚗</text></svg>" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Quicksand:wght@600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- 🍊 Navbar -->
    <header class="navbar">
      <a href={baseUrl} class="logo">
        <span class="logo-icon">🍊</span>
        <span class="logo-text">Orange<span class="highlight">Arcade</span></span>
      </a>
      <nav class="nav-links">
        <a href={baseUrl} class="nav-btn">🏠 Home</a>
        <a href="#about-drift-boss" class="nav-btn cute-btn">📖 How to Play</a>
      </nav>
    </header>

    <main class="container">
      <!-- 🎮 Drift Boss Game Section -->
      <section class="game-showcase">
        <div class="section-badge">🔥 Unblocked & Free to Play 🎮</div>
        <h1 class="game-title">{gameDetails.title}</h1>

        <!-- 🕹️ Click to Play Facade -->
        <div 
          class="iframe-wrapper" 
          id="gameContainer" 
          data-embed={gameDetails.embedUrl}
          data-title={gameDetails.title}
        >
          <div class="play-overlay" id="playOverlay">
            <div class="poster-badge">🕹️ 1-Click Drifting Action</div>
            <div class="poster-icon">🚗💨</div>
            <p class="poster-hint">Tap / Click to Drift like a Boss!</p>
            <button class="big-play-btn" id="startPlayBtn" aria-label="Play Drift Boss Unblocked">
              <span class="play-icon">▶</span>
              <span class="play-text">PLAY DRIFT BOSS</span>
            </button>
          </div>
        </div>

        <div class="game-info">
          <p class="desc">{gameDetails.description}</p>
          <div class="tags">
            {gameDetails.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- 📖 SEO Content & Guide Section -->
      <section id="about-drift-boss" class="seo-guide-section">
        <div class="guide-card">
          <h2>🎯 What is Drift Boss Unblocked?</h2>
          <p>
            <strong>Drift Boss Unblocked</strong> ek super addictive aur fast-paced casual game hai jisme aapko ek car ko zigzag curvy track par control karna hota hai. Is game ko aap kisi bhi school, college ya office network par bina kisi restriction ke enjoy kar sakte hain!
          </p>

          <div class="controls-grid">
            <div class="control-box">
              <span class="ctrl-icon">🖱️</span>
              <h3>PC / Laptop</h3>
              <p><strong>Left Click</strong> ya <strong>Spacebar</strong> press karke Right turn lein. Release karke Left jayein.</p>
            </div>
            <div class="control-box">
              <span class="ctrl-icon">📱</span>
              <h3>Mobile / Tablet</h3>
              <p>Screen par <strong>Touch & Hold</strong> karke Right turn lein aur ungli uthakar Left jayein.</p>
            </div>
          </div>

          <h3>✨ Tips to Score High in Drift Boss:</h3>
          <ul class="tips-list">
            <li>🟡 <strong>Time Your Turns:</strong> Har turn se thoda pehle click press karein taaki car platform se niche na gire.</li>
            <li>🪙 <strong>Collect Daily Coins:</strong> Daily reward coins se insurance aur double score booster purchase karein.</li>
            <li>🏎️ <strong>Unlock Cool Vehicles:</strong> Trucks, taxis, aur sports cars unlock karke unki unique handling enjoy karein.</li>
          </ul>
        </div>
      </section>

      <!-- 🕹️ More Cute Games Section -->
      <section id="games" class="more-games-section">
        <div class="section-header">
          <h2>🐾 More Cute Games 🍊</h2>
          <p>Explore other unblocked arcade games!</p>
        </div>

        <div class="games-grid">
          {moreGames.map(game => (
            <article class="game-card">
              <span class="card-badge">{game.tag}</span>
              <div class="card-icon">{game.emoji}</div>
              <h3 class="card-title">{game.title}</h3>
              <p class="card-cat">{game.category}</p>
              <div class="card-bottom">
                <span class="rating">{game.rating}</span>
                <a href={game.url} class="play-btn">Play 🕹️</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <!-- 🌸 Footer -->
    <footer>
      <p>Made with 🧡 & Astro JS | Drift Boss Unblocked • OrangeArcade ✨🐾</p>
    </footer>

    <!-- 🚀 Click to Load Game Script -->
    <script>
      const startBtn = document.getElementById('startPlayBtn');
      const gameContainer = document.getElementById('gameContainer');

      if (startBtn && gameContainer) {
        startBtn.addEventListener('click', () => {
          const embedUrl = gameContainer.getAttribute('data-embed');
          const gameTitle = gameContainer.getAttribute('data-title') || 'Drift Boss Unblocked';

          startBtn.innerHTML = '<span class="play-text">Loading Track... ⏳</span>';
          startBtn.style.opacity = '0.8';

          setTimeout(() => {
            gameContainer.innerHTML = `
              <iframe 
                src="${embedUrl}" 
                title="${gameTitle}" 
                allow="autoplay; fullscreen; pointer-lock" 
                allowfullscreen 
                class="active-iframe"
              ></iframe>
            `;
          }, 200);
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    --primary-orange: #d95300;
    --soft-orange: #ff7b25;
    --light-peach: #fff7f2;
    --card-bg: #ffffff;
    --text-dark: #3a2210;
    --border-orange: #ffd8bf;
    --shadow-cute: 0px 10px 24px rgba(217, 83, 0, 0.12);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Quicksand', system-ui, -apple-system, sans-serif;
    background-color: var(--light-peach);
    color: var(--text-dark);
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* 🍊 Navbar */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    max-width: 1100px;
    margin: 0 auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700;
    color: var(--primary-orange);
    text-decoration: none;
  }

  .logo-icon {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    animation: pulse 2s infinite ease-in-out;
  }

  .highlight {
    color: var(--soft-orange);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.4rem, 1.5vw, 1rem);
  }

  .nav-btn {
    text-decoration: none;
    font-weight: 700;
    color: var(--text-dark);
    padding: 0.5rem clamp(0.8rem, 2vw, 1.2rem);
    border-radius: 99px;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    transition: transform 0.2s ease;
  }

  .cute-btn {
    background: var(--primary-orange);
    color: #fff;
    box-shadow: 0 4px 12px rgba(217, 83, 0, 0.25);
  }

  .cute-btn:hover {
    transform: translateY(-2px);
    background: var(--soft-orange);
  }

  /* 📦 Layout Container */
  .container {
    width: 100%;
    max-width: min(1000px, 94vw);
    margin: 1rem auto 3rem auto;
  }

  /* 🎮 Game Box */
  .game-showcase {
    background: var(--card-bg);
    border-radius: clamp(18px, 3vw, 28px);
    padding: clamp(1rem, 3vw, 2rem);
    text-align: center;
    border: 2px solid var(--border-orange);
    box-shadow: var(--shadow-cute);
  }

  .section-badge {
    display: inline-block;
    background: #ffe3cd;
    color: var(--primary-orange);
    font-weight: 700;
    padding: 0.3rem clamp(0.8rem, 2vw, 1.2rem);
    border-radius: 20px;
    font-size: clamp(0.75rem, 1.8vw, 0.85rem);
    margin-bottom: 0.6rem;
  }

  .game-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.4rem, 4vw, 2.1rem);
    color: var(--primary-orange);
    margin-bottom: 1.2rem;
  }

  /* 🕹️ Fast Facade Frame */
  .iframe-wrapper {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    min-height: 260px;
    border-radius: clamp(14px, 2.5vw, 20px);
    overflow: hidden;
    background: #1a0f07;
    border: 4px solid var(--soft-orange);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-overlay {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #2e160a 0%, #120904 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
  }

  .poster-badge {
    background: rgba(255, 123, 37, 0.2);
    color: #ffaa66;
    font-weight: 700;
    font-size: clamp(0.75rem, 1.6vw, 0.85rem);
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 123, 37, 0.4);
  }

  .poster-icon {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    animation: drift 2s infinite ease-in-out;
  }

  .poster-hint {
    color: #ffd8bf;
    font-weight: 600;
    font-size: clamp(0.85rem, 2vw, 1rem);
  }

  .big-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #ff7b25 0%, #d95300 100%);
    color: #ffffff;
    border: 3px solid #ffe3cd;
    padding: clamp(0.7rem, 2vw, 1rem) clamp(1.5rem, 4vw, 2.5rem);
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 99px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 123, 37, 0.5);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    margin-top: 0.4rem;
  }

  .big-play-btn:hover {
    transform: scale(1.06);
  }

  .play-icon {
    font-size: 1.2em;
  }

  :global(.active-iframe) {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .game-info {
    margin-top: 1.2rem;
  }

  .desc {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    font-weight: 600;
    color: #55341c;
    margin-bottom: 0.8rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    background: #fff0e2;
    color: var(--primary-orange);
    padding: 0.25rem 0.8rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* 📖 SEO Guide Card */
  .seo-guide-section {
    margin-top: 2.5rem;
  }

  .guide-card {
    background: var(--card-bg);
    border: 2px solid var(--border-orange);
    border-radius: 24px;
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow: var(--shadow-cute);
  }

  .guide-card h2 {
    font-family: 'Fredoka', system-ui, sans-serif;
    color: var(--primary-orange);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    margin-bottom: 0.8rem;
  }

  .guide-card h3 {
    font-family: 'Fredoka', system-ui, sans-serif;
    color: var(--text-dark);
    margin: 1.2rem 0 0.6rem 0;
  }

  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.2rem 0;
  }

  .control-box {
    background: #fff3ea;
    border: 1.5px solid var(--border-orange);
    border-radius: 16px;
    padding: 1rem;
    text-align: center;
  }

  .ctrl-icon {
    font-size: 2rem;
  }

  .tips-list {
    margin-left: 1.2rem;
    color: #55341c;
    font-weight: 600;
  }

  .tips-list li {
    margin-bottom: 0.5rem;
  }

  /* 🕹️ More Games Grid */
  .more-games-section {
    margin-top: 3rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: var(--primary-orange);
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .game-card {
    background: var(--card-bg);
    border: 1.5px solid var(--border-orange);
    border-radius: 20px;
    padding: 1.2rem;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 15px rgba(217, 83, 0, 0.06);
    transition: transform 0.25s ease;
  }

  .game-card:hover {
    transform: translateY(-5px);
  }

  .card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ffe6d4;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    color: var(--primary-orange);
  }

  .card-icon {
    font-size: clamp(2.3rem, 5vw, 2.8rem);
    margin: 0.5rem 0;
  }

  .card-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
  }

  .card-cat {
    font-size: 0.8rem;
    color: #8c6a4d;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rating {
    font-weight: 700;
    font-size: 0.85rem;
    color: #d95300;
  }

  .play-btn {
    background: var(--primary-orange);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 10px;
    display: inline-block;
  }

  footer {
    text-align: center;
    padding: clamp(1.2rem, 3vw, 2rem);
    font-weight: 600;
    font-size: clamp(0.8rem, 2vw, 0.95rem);
    color: #6e4b30;
    background: #ffede0;
    margin-top: 2.5rem;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes drift {
    0%, 100% { transform: rotate(0deg) translateX(0); }
    50% { transform: rotate(-10deg) translateX(-5px); }
  }

  @media (max-width: 480px) {
    .navbar {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>
