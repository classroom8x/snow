---
// src/pages/index.astro
const featuredGame = {
  title: "🏎️ PolyTrack 3D Racer 🏁",
  // Working PolyTrack Embed URL:
  embedUrl: "https://polytrack-online.github.io/", 
  description: "Fast-paced low-poly track racing game! Apni car drive karein aur best speed record banayein! 🚗💨✨",
  tags: ["#Racing", "#3DGame", "#PolyTrack", "#Fun"]
};

const moreGames = [
  {
    title: "Cat Bakery Tycoon 🐾",
    category: "Simulation",
    emoji: "🐱🥐",
    rating: "⭐ 4.9",
    tag: "Trending 🔥"
  },
  {
    title: "Cozy Pixel Farm 🌾",
    category: "Casual",
    emoji: "🐥🥕",
    rating: "⭐ 4.8",
    tag: "Cute 💖"
  },
  {
    title: "Sunny Space Jump 🚀",
    category: "Action",
    emoji: "🌟🍊",
    rating: "⭐ 4.7",
    tag: "Popular 🎉"
  },
  {
    title: "Bubble Pop Party 🫧",
    category: "Puzzle",
    emoji: "🎈✨",
    rating: "⭐ 4.9",
    tag: "New 🆕"
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PolyTrack 🏎️ OrangeArcade ✨</title>
    <meta name="description" content="Play PolyTrack 3D racing game online for free on OrangeArcade!" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍊</text></svg>" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Quicksand:wght@600;700&display=swap" media="print" onload="this.media='all'" />
  </head>

  <body>
    <!-- 🍊 Navbar -->
    <header class="navbar">
      <div class="logo">
        <span class="logo-icon">🍊</span>
        <span class="logo-text">Orange<span class="highlight">Arcade</span></span>
      </div>
      <nav class="nav-links">
        <a href="#games" class="nav-btn">🎮 All Games</a>
        <a href="#games" class="nav-btn cute-btn">✨ Play Daily</a>
      </nav>
    </header>

    <main class="container">
      <!-- 🎮 Featured PolyTrack Game -->
      <section class="game-showcase">
        <div class="section-badge">✨ Featured Game 🏎️</div>
        <h1 class="game-title">{featuredGame.title}</h1>

        <div class="iframe-wrapper">
          <iframe 
            src={featuredGame.embedUrl}
            title={featuredGame.title}
            allow="autoplay; fullscreen; pointer-lock" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>

        <div class="game-info">
          <p class="desc">{featuredGame.description}</p>
          <div class="tags">
            {featuredGame.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- 🕹️ More Games -->
      <section id="games" class="more-games-section">
        <div class="section-header">
          <h2>🐾 More Cute Games 🍊</h2>
          <p>Apna next favorite game choose karein!</p>
        </div>

        <div class="games-grid">
          {moreGames.map(game => (
            <article class="game-card">
              <span class="card-badge">{game.tag}</span>
              <div class="card-icon">{game.emoji}</div>
              <h3 class="card-title">{game.title}</h3>
              <p class="card-cat">{game.category}</p>
              <div class="card-bottom">
                <span class="rating">{game.rating}</span>
                <button class="play-btn" aria-label={`Play ${game.title}`}>Play 🕹️</button>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <!-- 🌸 Footer -->
    <footer>
      <p>Made with 🧡 & Astro JS | PolyTrack Arcade World ✨🐾</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --primary-orange: #d95300;
    --soft-orange: #ff7b25;
    --light-peach: #fff7f2;
    --card-bg: #ffffff;
    --text-dark: #3a2210;
    --border-orange: #ffd8bf;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Quicksand', system-ui, sans-serif;
    background-color: var(--light-peach);
    color: var(--text-dark);
    line-height: 1.5;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-orange);
  }

  .logo-icon {
    font-size: 1.8rem;
  }

  .highlight {
    color: var(--soft-orange);
  }

  .nav-links {
    display: flex;
    gap: 0.8rem;
  }

  .nav-btn {
    text-decoration: none;
    font-weight: 700;
    color: var(--text-dark);
    padding: 0.6rem 1rem;
    border-radius: 99px;
    font-size: 0.95rem;
  }

  .cute-btn {
    background: var(--primary-orange);
    color: #fff;
  }

  .container {
    max-width: 900px;
    margin: 1rem auto 3rem auto;
    padding: 0 1rem;
  }

  .game-showcase {
    background: var(--card-bg);
    border-radius: 24px;
    padding: 1.5rem;
    text-align: center;
    border: 2px solid var(--border-orange);
    box-shadow: 0px 8px 24px rgba(217, 83, 0, 0.08);
  }

  .section-badge {
    display: inline-block;
    background: #ffe3cd;
    color: var(--primary-orange);
    font-weight: 700;
    padding: 0.3rem 0.9rem;
    border-radius: 16px;
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .game-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.7rem;
    color: var(--primary-orange);
    margin-bottom: 1.2rem;
  }

  .iframe-wrapper {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    border: 4px solid var(--soft-orange);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .game-info {
    margin-top: 1.2rem;
  }

  .desc {
    font-size: 1rem;
    font-weight: 600;
    color: #55341c;
    margin-bottom: 0.8rem;
  }

  .tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    background: #fff0e2;
    color: var(--primary-orange);
    padding: 0.2rem 0.7rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .more-games-section {
    margin-top: 2.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.6rem;
    color: var(--primary-orange);
  }

  .section-header p {
    color: #6e4b30;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
  }

  .game-card {
    background: var(--card-bg);
    border: 1.5px solid var(--border-orange);
    border-radius: 18px;
    padding: 1.2rem;
    text-align: center;
    position: relative;
  }

  .card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ffe6d4;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    color: var(--primary-orange);
  }

  .card-icon {
    font-size: 2.6rem;
    margin: 0.5rem 0;
  }

  .card-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
  }

  .card-cat {
    font-size: 0.8rem;
    color: #8c6a4d;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rating {
    font-weight: 700;
    font-size: 0.85rem;
    color: #d95300;
  }

  .play-btn {
    background: var(--primary-orange);
    color: #fff;
    border: none;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 10px;
    cursor: pointer;
    min-height: 40px;
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: #6e4b30;
    background: #ffede0;
  }

  @media (max-width: 600px) {
    .game-title {
      font-size: 1.3rem;
    }
    .game-showcase {
      padding: 1rem;
    }
  }
</style>