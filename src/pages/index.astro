---
// src/pages/index.astro
const featuredGame = {
  title: "🏎️ PolyTrack 3D Racer 🏁",
  embedUrl: "https://polytrack-online.github.io/",
  description: "Fast-paced low-poly track racing game! Apni car drive karein, stunts karein aur best speed record banayein! 🚗💨✨",
  tags: ["#Racing", "#3DGame", "#PolyTrack", "#CuteArcade"]
};

const moreGames = [
  {
    title: "Cat Bakery Tycoon 🐾",
    category: "Simulation",
    emoji: "🐱🥐",
    rating: "⭐ 4.9",
    tag: "Trending 🔥"
  },
  {
    title: "Cozy Pixel Farm 🌾",
    category: "Casual",
    emoji: "🐥🥕",
    rating: "⭐ 4.8",
    tag: "Cute 💖"
  },
  {
    title: "Sunny Space Jump 🚀",
    category: "Action",
    emoji: "🌟🍊",
    rating: "⭐ 4.7",
    tag: "Popular 🎉"
  },
  {
    title: "Bubble Pop Party 🫧",
    category: "Puzzle",
    emoji: "🎈✨",
    rating: "⭐ 4.9",
    tag: "New 🆕"
  },
  {
    title: "Hamster Maze Rush 🐹",
    category: "Arcade",
    emoji: "🧀🏃",
    rating: "⭐ 4.8",
    tag: "Hot ⚡"
  },
  {
    title: "Fruit Splash Match 🍓",
    category: "Puzzle",
    emoji: "🍊🍉",
    rating: "⭐ 4.9",
    tag: "Fun 🎯"
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>PolyTrack 🏎️ OrangeArcade ✨ Cute Games Station</title>
    <meta name="description" content="Play PolyTrack 3D racing game and other cute arcade games online directly in your browser!" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍊</text></svg>" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Quicksand:wght@600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- 🍊 Responsive Navbar -->
    <header class="navbar">
      <div class="logo">
        <span class="logo-icon">🍊</span>
        <span class="logo-text">Orange<span class="highlight">Arcade</span></span>
      </div>
      <nav class="nav-links">
        <a href="#games" class="nav-btn">🎮 All Games</a>
        <a href="#games" class="nav-btn cute-btn">✨ Play Daily</a>
      </nav>
    </header>

    <main class="container">
      <!-- 🎮 Featured Game Section -->
      <section class="game-showcase">
        <div class="section-badge">✨ Featured Game of the Day 🏎️</div>
        <h1 class="game-title">{featuredGame.title}</h1>

        <!-- 🕹️ Interactive Game Container with Play Button -->
        <div 
          class="iframe-wrapper" 
          id="gameContainer" 
          data-embed={featuredGame.embedUrl}
          data-title={featuredGame.title}
        >
          <div class="play-overlay" id="playOverlay">
            <div class="poster-badge">🏁 3D Track Racing</div>
            <div class="poster-icon">🏎️💨</div>
            <p class="poster-hint">Click below to start playing!</p>
            <button class="big-play-btn" id="startPlayBtn" aria-label="Play Game">
              <span class="play-icon">▶</span>
              <span class="play-text">PLAY NOW</span>
            </button>
          </div>
        </div>

        <div class="game-info">
          <p class="desc">{featuredGame.description}</p>
          <div class="tags">
            {featuredGame.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- 🕹️ Responsive Games Grid Section -->
      <section id="games" class="more-games-section">
        <div class="section-header">
          <h2>🐾 More Cute Games 🍊</h2>
          <p>Apna next favorite game choose karein!</p>
        </div>

        <div class="games-grid">
          {moreGames.map(game => (
            <article class="game-card">
              <span class="card-badge">{game.tag}</span>
              <div class="card-icon">{game.emoji}</div>
              <h3 class="card-title">{game.title}</h3>
              <p class="card-cat">{game.category}</p>
              <div class="card-bottom">
                <span class="rating">{game.rating}</span>
                <button class="play-btn" aria-label={`Play ${game.title}`}>Play 🕹️</button>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <!-- 🌸 Cute Responsive Footer -->
    <footer>
      <p>Made with 🧡 & Astro JS | Cute Gaming World ✨🐾</p>
    </footer>

    <!-- 🚀 Click to Load Game Script -->
    <script>
      const startBtn = document.getElementById('startPlayBtn');
      const gameContainer = document.getElementById('gameContainer');

      if (startBtn && gameContainer) {
        startBtn.addEventListener('click', () => {
          const embedUrl = gameContainer.getAttribute('data-embed');
          const gameTitle = gameContainer.getAttribute('data-title') || 'Game';

          // Show loading state
          startBtn.innerHTML = '<span class="play-text">Loading Game... ⏳</span>';
          startBtn.style.opacity = '0.8';

          setTimeout(() => {
            gameContainer.innerHTML = `
              <iframe 
                src="${embedUrl}" 
                title="${gameTitle}" 
                allow="autoplay; fullscreen; pointer-lock" 
                allowfullscreen 
                class="active-iframe"
              ></iframe>
            `;
          }, 200);
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    --primary-orange: #d95300;
    --soft-orange: #ff7b25;
    --light-peach: #fff7f2;
    --card-bg: #ffffff;
    --text-dark: #3a2210;
    --border-orange: #ffd8bf;
    --shadow-cute: 0px 10px 24px rgba(217, 83, 0, 0.12);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Quicksand', system-ui, -apple-system, sans-serif;
    background-color: var(--light-peach);
    color: var(--text-dark);
    line-height: 1.5;
    overflow-x: hidden;
  }

  /* 🍊 Navbar */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    max-width: 1100px;
    margin: 0 auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700;
    color: var(--primary-orange);
  }

  .logo-icon {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    animation: pulse 2s infinite ease-in-out;
  }

  .highlight {
    color: var(--soft-orange);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.4rem, 1.5vw, 1rem);
  }

  .nav-btn {
    text-decoration: none;
    font-weight: 700;
    color: var(--text-dark);
    padding: 0.5rem clamp(0.8rem, 2vw, 1.2rem);
    border-radius: 99px;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .cute-btn {
    background: var(--primary-orange);
    color: #fff;
    box-shadow: 0 4px 12px rgba(217, 83, 0, 0.25);
  }

  .cute-btn:hover {
    transform: translateY(-2px);
    background: var(--soft-orange);
  }

  /* 📦 Layout Container */
  .container {
    width: 100%;
    max-width: min(1000px, 94vw);
    margin: 1rem auto 3rem auto;
  }

  /* 🎮 Featured Game Box */
  .game-showcase {
    background: var(--card-bg);
    border-radius: clamp(18px, 3vw, 28px);
    padding: clamp(1rem, 3vw, 2rem);
    text-align: center;
    border: 2px solid var(--border-orange);
    box-shadow: var(--shadow-cute);
  }

  .section-badge {
    display: inline-block;
    background: #ffe3cd;
    color: var(--primary-orange);
    font-weight: 700;
    padding: 0.3rem clamp(0.8rem, 2vw, 1.2rem);
    border-radius: 20px;
    font-size: clamp(0.75rem, 1.8vw, 0.85rem);
    margin-bottom: 0.6rem;
  }

  .game-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.4rem, 4vw, 2.1rem);
    color: var(--primary-orange);
    margin-bottom: 1.2rem;
  }

  /* 🕹️ Responsive Iframe & Play Button Overlay */
  .iframe-wrapper {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    min-height: 260px;
    border-radius: clamp(14px, 2.5vw, 20px);
    overflow: hidden;
    background: #1e130c;
    border: 4px solid var(--soft-orange);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-overlay {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #351c0f 0%, #170d06 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    user-select: none;
  }

  .poster-badge {
    background: rgba(255, 123, 37, 0.2);
    color: #ffaa66;
    font-weight: 700;
    font-size: clamp(0.75rem, 1.6vw, 0.85rem);
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 123, 37, 0.4);
  }

  .poster-icon {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    animation: float 2.5s infinite ease-in-out;
  }

  .poster-hint {
    color: #ffd8bf;
    font-weight: 600;
    font-size: clamp(0.85rem, 2vw, 1rem);
  }

  /* 🔘 Big Cute Play Button */
  .big-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #ff7b25 0%, #d95300 100%);
    color: #ffffff;
    border: 3px solid #ffe3cd;
    padding: clamp(0.7rem, 2vw, 1rem) clamp(1.5rem, 4vw, 2.5rem);
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 99px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 123, 37, 0.5), 0 0 0 4px rgba(255, 123, 37, 0.2);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
    margin-top: 0.4rem;
  }

  .big-play-btn:hover {
    transform: scale(1.06);
    box-shadow: 0 8px 25px rgba(255, 123, 37, 0.7), 0 0 0 6px rgba(255, 123, 37, 0.3);
  }

  .big-play-btn:active {
    transform: scale(0.96);
  }

  .play-icon {
    font-size: 1.2em;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  :global(.active-iframe) {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .game-info {
    margin-top: 1.2rem;
  }

  .desc {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    font-weight: 600;
    color: #55341c;
    margin-bottom: 0.8rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    background: #fff0e2;
    color: var(--primary-orange);
    padding: 0.25rem 0.8rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* 🕹️ More Games Grid (Responsive Auto-Fit) */
  .more-games-section {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: var(--primary-orange);
  }

  .section-header p {
    color: #6e4b30;
    font-weight: 600;
    font-size: clamp(0.85rem, 2vw, 1rem);
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .game-card {
    background: var(--card-bg);
    border: 1.5px solid var(--border-orange);
    border-radius: 20px;
    padding: 1.2rem;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 15px rgba(217, 83, 0, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .game-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-cute);
  }

  .card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ffe6d4;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    color: var(--primary-orange);
  }

  .card-icon {
    font-size: clamp(2.3rem, 5vw, 2.8rem);
    margin: 0.5rem 0;
  }

  .card-title {
    font-family: 'Fredoka', system-ui, sans-serif;
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
  }

  .card-cat {
    font-size: 0.8rem;
    color: #8c6a4d;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rating {
    font-weight: 700;
    font-size: 0.85rem;
    color: #d95300;
  }

  .play-btn {
    background: var(--primary-orange);
    color: #fff;
    border: none;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    cursor: pointer;
    min-height: 40px;
    transition: background 0.2s ease;
  }

  .play-btn:hover {
    background: var(--soft-orange);
  }

  /* 🌸 Footer */
  footer {
    text-align: center;
    padding: clamp(1.2rem, 3vw, 2rem);
    font-weight: 600;
    font-size: clamp(0.8rem, 2vw, 0.95rem);
    color: #6e4b30;
    background: #ffede0;
    margin-top: 2rem;
  }

  /* ✨ Keyframe Animations */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  /* 📱 Extra Small Screen Optimizations */
  @media (max-width: 480px) {
    .navbar {
      flex-direction: column;
      gap: 0.8rem;
    }
    .iframe-wrapper {
      min-height: 220px;
    }
    .big-play-btn {
      width: 90%;
    }
  }
</style>